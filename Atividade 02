# entrada de dados
n1 = int(input("Informe o n1: "))
n2 = int(input("Informe o n2: "))

# processamento de dados
soma = n1 + n2
subtracao = n1 - n2
multiplicacao = n1 * n2
divisao = n1 / n2
resto = n1 % n2

# sáida de dados
print(f"Soma: {soma}")
print(f"Subtracao: {subtracao}")
print(f"Multiplicacao: {subtracao}")
print(f"Divisao: {divisao}")
print(f"Resto da divisao: {resto}")